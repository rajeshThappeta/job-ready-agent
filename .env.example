# Server
PORT=5001
NODE_ENV=development

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
# Required: a chat model that supports tool calling in Ollama
OLLAMA_MODEL= qwen3:8b
# Context window to request; READMEs and job pages can be long
OLLAMA_NUM_CTX=8192
# Keep low for reliable tool selection
LLM_TEMPERATURE=0.1

# Agent loop
AGENT_MAX_STEPS=6

# External fetches (GitHub API, job pages)
HTTP_TIMEOUT_MS=10000
# Max characters of README / job page text sent to the model
MAX_CONTENT_CHARS=8000
# Optional: raises GitHub API limit from ~60 to a higher number per hour
GITHUB_TOKEN=

# saveRoadmap output
ROADMAP_OUTPUT_DIR=./roadmaps